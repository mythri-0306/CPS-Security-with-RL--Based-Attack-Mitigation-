\@writefile{toc}{\contentsline {subsubsection}{\numberline {0.0.1}Matched supervisory controls and attribution protocol}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {0.0.2}Matched supervisory candidate generators}{2}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Matched deployment-only supervisory controls on SUMO $4\times 4$ and $7\times 28$. All entries use the same frozen base checkpoint within each seed. Reward, ATT, and effective changes per episode are expressed as mean $\pm $ SD. $\Delta $ATT is ATT(control)$-$ATT(LLM); positive values favor the LLM; brackets contain paired 95\% confidence intervals. Effective changes are defined in the action audit.}}{3}{}\protected@file@percent }
\newlabel{tab:matched_controls}{{1}{3}{}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Matched supervisory comparison on SUMO $4\times 4$ and $7\times 28$. Panels (a,b): seed-level ATT with mean and 95\% confidence intervals for the LLM and nonlanguage candidate generators. Panels (c,d): unchanged and modified raw proposal-change counts, with effective executed changes shown as separate markers. Effective changes are a separate, potentially overlapping outcome. All panels use the same reported checkpoints and evaluation horizon.}}{3}{}\protected@file@percent }
\newlabel{fig:matched_supervisors}{{1}{3}{}{figure.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {0.0.3}Separating training and deployment supervision}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Training--evaluation $2\times 2$ factorial on both SUMO networks. Values are mean $\pm $ SD over matched seeds. The two evaluation rows for a training condition use exactly the same frozen checkpoint. ``Off'' retains projection.}}{4}{}\protected@file@percent }
\newlabel{tab:factorial}{{2}{4}{}{table.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {0.0.4}Empirical validation of the confidence trigger}{4}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Held-out confidence-trigger validation on both SUMO networks. Discrimination metrics include 95\% confidence intervals. Positive-class prevalence is shown for AUPRC. Intervention gain uses the same selected fraction of states (top 10\%). Error and OOD labels are complementary diagnostics; intervention benefit directly tests gate utility.}}{5}{}\protected@file@percent }
\newlabel{tab:confidence_validation}{{3}{5}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Empirical validation of the confidence heuristic. Panel (a): precision--recall curves for positive intervention benefit, comparing negative Q-margin and ensemble disagreement, with the positive-class prevalence baseline. Panel (b): mean intervention gain versus selected fraction under matched budgets, with seed-clustered 95\% confidence intervals. Label definitions, horizon, supervisor, sample counts, and held-out conditions follow the validation protocol. These plots assess ranking and utility, not probability calibration.}}{5}{}\protected@file@percent }
\newlabel{fig:confidence_validation}{{2}{5}{}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Post-projection attribution audit. Each row uses the frozen no-LLM-training checkpoint for each seed. Counts are pooled over 8 matched seeds and equal episode horizons. Raw changes, unchanged proposals, projection-modified proposals, and effective changes are denoted by $N_{\rm  raw}$, $N_{\rm  unch}$, $N_{\rm  mod}$, and $N_{\rm  eff}$.}}{6}{}\protected@file@percent }
\newlabel{tab:execution_audit}{{4}{6}{}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Matched multi-seed CityFlow controls on Hangzhou, Jinan, and New York. Values are mean $\pm $ SD over 8 matched seeds with common evaluation horizons and frozen checkpoints; the paired difference is reward(variant)$-$reward(no-LLM full pipeline), with a 95\% CI. Raw and effective counts distinguish proposal changes from execution.}}{7}{}\protected@file@percent }
\newlabel{tab:cityflow_matched}{{5}{7}{}{table.5}{}}
